{
  "framework": null,
  "functions": {
    "api/ipfs-proxy.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ipfs-proxy/:file",
      "destination": "/api/ipfs-proxy?file=:file"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
